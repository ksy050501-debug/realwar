rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 천하쟁패 저장: 문서 ID(이름+비밀번호 해시)를 아는 사람만 읽고 쓸 수 있음. 목록 조회 금지.
    match /realwar_saves/{saveId} {
      allow get: if true;
      allow list: if false;
      allow create, update: if request.resource.data.keys().hasAll(['d','name','turn'])
                            && request.resource.data.d is string
                            && request.resource.data.d.size() < 900000;
      allow delete: if false;
    }
    // 그 밖의 모든 경로는 막음
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
